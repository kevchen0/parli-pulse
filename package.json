{
  "name": "parli-pulse",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build && tsc --noEmit -p apps/web/tsconfig.json",
    "backtest": "node scripts/backtest-fields.ts && node scripts/backtest-points.ts && node scripts/backtest-teams.ts",
    "backtest:fields": "node scripts/backtest-fields.ts",
    "backtest:points": "node scripts/backtest-points.ts",
    "backtest:teams": "node scripts/backtest-teams.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fetch": "node --env-file-if-exists=.env scripts/fetch.ts",
    "check:rules": "node scripts/check-rules.ts",
    "check:walkovers": "node --env-file-if-exists=.env scripts/check-walkovers.ts",
    "compare:sources": "node scripts/compare-sources.ts",
    "load": "node --env-file-if-exists=.env scripts/load.ts",
    "rollup": "node --env-file-if-exists=.env scripts/rollup.ts",
    "compare": "node --env-file-if-exists=.env scripts/compare-top.ts",
    "diagnose": "node --env-file-if-exists=.env scripts/diagnose.ts",
    "diagnostics": "node --env-file-if-exists=.env scripts/build-diagnostics.ts",
    "mark-ingest": "node --env-file-if-exists=.env scripts/mark-ingest.ts",
    "speaks": "node --env-file-if-exists=.env scripts/speaks.ts",
    "rate": "node --env-file-if-exists=.env scripts/rate.ts",
    "validate:rating": "node --env-file-if-exists=.env scripts/validate-rating.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "pg": "^8.23.0"
  }
}
